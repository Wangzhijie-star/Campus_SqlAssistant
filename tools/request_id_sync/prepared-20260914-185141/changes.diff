+    async def pause_for_test(self, lease):
+        """Opt-in local acceptance window; async sleep leaves lease renewal running."""
+        raw = os.environ.get('SQLBOT_TEST_PAUSE_SECONDS', '0')
+        try:
+            seconds = float(raw)
+            if not isfinite(seconds) or not 0 <= seconds <= 120:
+                raise ValueError()
+        except ValueError:
+            raise GateRejected('TEST_PAUSE_INVALID', 'SQLBOT_TEST_PAUSE_SECONDS must be between 0 and 120', 503)
+        if not seconds:
+            return
+        logger.warning('Acceptance test pause: holding request/chat locks for %s seconds before execution', seconds)
+        await asyncio.sleep(seconds)
+        try:
+            lease.ensure_active()
+        except LeaseLostError:
+            raise GateRejected('COORDINATION_UNAVAILABLE', 'Execution lease lost during test pause', 503) from None
+
